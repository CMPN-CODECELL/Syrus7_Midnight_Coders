# ==============================================================================
# TradeShield Database Configuration Options
# ==============================================================================
# OPTION 1: Zero-Config SQLite (Default - Recommended for instant GitHub clone & judges)
# If PostgreSQL is offline or DATABASE_URL starts with sqlite, the platform
# automatically initializes local SQLite at backend/tradeshield.db with 0 setup needed:
# DATABASE_URL=sqlite+aiosqlite:///backend/tradeshield.db

# OPTION 2: Local Docker Compose PostgreSQL (Run: `docker compose up -d postgres`)
DATABASE_URL=postgresql+asyncpg://tradeshield:tradeshield@localhost:5434/tradeshield

# OPTION 3: Free Hosted Cloud PostgreSQL (Neon.tech / Supabase / Railway)
# Paste your cloud Postgres URL here with ssl=require:
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-cool-db.us-east-1.aws.neon.tech/tradeshield?ssl=require

# ==============================================================================
# Security & JWT Token Auth
# ==============================================================================
JWT_SECRET=trade-shield-dev-secret-key-change-in-prod-2026

